# Production .env for deploy/docker-compose.prod.yml. Copy to deploy/.env,
# chmod 600, and fill in. Never commit the real file.
# Generate secrets with: openssl rand -hex 32

# --- Public address (Caddy) -------------------------------------------------
# DNS name that resolves to this server. Without a domain, <ip-with-dashes>.sslip.io works.
GOGA_DOMAIN=gateway.example.com
# Public HTTPS port. 443 if free; any other port (e.g. 4443) if 443 is taken.
GOGA_HTTPS_PORT=443
# Must match the two values above; omit ":443" when using the default port.
GATEWAY_PUBLIC_URL=https://gateway.example.com

# --- Secrets ----------------------------------------------------------------
GATEWAY_BOOTSTRAP_TOKEN=replace-with-openssl-rand-hex-32
BOT_INBOUND_SECRET=replace-with-openssl-rand-hex-32

# --- Bot bridge -------------------------------------------------------------
# mock (built-in auto reply) or webhook (real Grok Bot routine).
BOT_BRIDGE=mock
BOT_WEBHOOK_URL=
BOT_WEBHOOK_AUTH_HEADER=Authorization
BOT_WEBHOOK_AUTH_VALUE=
BOT_WEBHOOK_TIMEOUT_SECONDS=10
BOT_WEBHOOK_MAX_RETRIES=3
BOT_INBOUND_MAX_SKEW_SECONDS=300
BOT_MOCK_AUTO_REPLY=true

# --- Storage ----------------------------------------------------------------
# SQLite inside the container; the host directory is GOGA_DATA_DIR.
DATABASE_URL=jdbc:sqlite:/data/goga.db
DATABASE_USER=
DATABASE_PASSWORD=
# Host paths (relative to deploy/) for persistent data.
GOGA_DATA_DIR=./data/gateway
CADDY_DATA_DIR=./data/caddy
CADDY_CONFIG_DIR=./data/caddy-config

# --- User -------------------------------------------------------------------
USER_TIMEZONE=Europe/Moscow
SINGLE_USER_DISPLAY_NAME=Пользователь
# SINGLE_USER_ID=
PAIRING_CODE_TTL_SECONDS=600
