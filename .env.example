# Copy to .env and replace every placeholder before a real deployment.
# The gateway reads process environment variables only. Docker Compose
# interpolates this file when it is named .env and sits next to docker-compose.yml.
# Do not commit .env.

# One-time admin credential used to mint pairing codes. Not a user password.
GATEWAY_BOOTSTRAP_TOKEN=replace-with-a-long-random-string

# Shared secret for bot -> gateway HMAC. The bot stores the same value.
BOT_INBOUND_SECRET=replace-with-another-long-random-string

# mock (local round trip) or webhook (real Grok Bot routine).
BOT_BRIDGE=mock

# Required when BOT_BRIDGE=webhook. No real endpoint belongs in git.
BOT_WEBHOOK_URL=
BOT_WEBHOOK_AUTH_HEADER=Authorization
BOT_WEBHOOK_AUTH_VALUE=

# Public origin the bot calls back, without a trailing path.
GATEWAY_PUBLIC_URL=http://127.0.0.1:8080

# jdbc:sqlite:/data/goga.db  or  jdbc:postgresql://host:5432/goga
DATABASE_URL=jdbc:sqlite:./data/goga.db
DATABASE_USER=
DATABASE_PASSWORD=

HOST=0.0.0.0
PORT=8080

USER_TIMEZONE=Europe/Moscow
SINGLE_USER_DISPLAY_NAME=Пользователь
# Optional stable UUID. Used only when the database has no user row yet.
# SINGLE_USER_ID=

BOT_INBOUND_MAX_SKEW_SECONDS=300
BOT_WEBHOOK_TIMEOUT_SECONDS=10
BOT_WEBHOOK_MAX_RETRIES=3
PAIRING_CODE_TTL_SECONDS=600
BOT_MOCK_AUTO_REPLY=true
